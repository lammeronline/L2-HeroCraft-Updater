<Window x:Class="PatchBuilder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Patch Builder" Height="780" Width="1180" MinHeight="700" MinWidth="1040"
        Background="#0F1117" Foreground="#F6F1E8" FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#191B24" />
        <SolidColorBrush x:Key="SurfaceAltBrush" Color="#20232D" />
        <SolidColorBrush x:Key="SurfaceDeepBrush" Color="#11141C" />
        <SolidColorBrush x:Key="StrokeBrush" Color="#343847" />
        <SolidColorBrush x:Key="StrokeSoftBrush" Color="#292D39" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#B5AD9F" />
        <SolidColorBrush x:Key="TextSoftBrush" Color="#D8D0C3" />
        <SolidColorBrush x:Key="AccentBrush" Color="#C89B3C" />
        <SolidColorBrush x:Key="DangerBrush" Color="#B84E55" />
        <SolidColorBrush x:Key="PurpleBrush" Color="#6A4CC2" />

        <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#141722" Offset="0" />
            <GradientStop Color="#181820" Offset="0.46" />
            <GradientStop Color="#10131A" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2A2430" Offset="0" />
            <GradientStop Color="#1A1D27" Offset="0.54" />
            <GradientStop Color="#232018" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="PanelBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeSoftBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#F6F1E8" />
        </Style>

        <Style x:Key="LabelTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Foreground" Value="#F6F1E8" />
            <Setter Property="Background" Value="#2A2E3A" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Foreground" Value="#F6F1E8" />
            <Setter Property="Background" Value="{StaticResource SurfaceDeepBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
            <Setter Property="CaretBrush" Value="#F6F1E8" />
            <Setter Property="SelectionBrush" Value="#735C2B" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextSoftBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Background" Value="#0F1219" />
            <Setter Property="BorderBrush" Value="#2D303B" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid Margin="26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Patch Builder" FontSize="30" FontWeight="Bold" />
                    <TextBlock Text="Manifest generation, metadata updates and URL validation" Foreground="{StaticResource TextMutedBrush}" FontSize="13" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="LoadMetadataButton" Content="LOAD META" Width="118" Height="48"
                            Margin="0,0,10,0" Click="LoadMetadataButton_Click" />
                    <Button x:Name="SaveMetadataButton" Content="SAVE META" Width="118" Height="48"
                            Margin="0,0,10,0" Background="{StaticResource PurpleBrush}" BorderBrush="#7B5ED2" Click="SaveMetadataButton_Click" />
                    <Button x:Name="ValidateButton" Content="VALIDATE" Width="122" Height="48"
                            Margin="0,0,10,0" Click="ValidateButton_Click" />
                    <Button x:Name="GenerateButton" Content="GENERATE" Width="160" Height="48"
                            Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}"
                            Foreground="#17120A" FontSize="16" Click="GenerateButton_Click" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="0.9*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}" Margin="0,0,18,0" Padding="0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="18">
                            <TextBlock Text="Patch source" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,14" />

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,10,12">
                                    <TextBlock Text="Patch folder" Style="{StaticResource LabelTextStyle}" />
                                    <TextBox x:Name="SourceDirectoryBox" />
                                </StackPanel>
                                <Button Grid.Row="0" Grid.Column="1" Content="Browse" Width="96" VerticalAlignment="Bottom" Margin="0,0,0,12" Click="BrowseSourceButton_Click" />

                                <StackPanel Grid.Row="1" Margin="0,0,10,12">
                                    <TextBlock Text="Source URL" Style="{StaticResource LabelTextStyle}" />
                                    <TextBox x:Name="BaseUrlBox" />
                                </StackPanel>
                                <Button Grid.Row="1" Grid.Column="1" Content="Local" Width="96" VerticalAlignment="Bottom" Margin="0,0,0,12" Click="UseLocalButton_Click" />

                                <StackPanel Grid.Row="2" Margin="0,0,10,12">
                                    <TextBlock Text="Manifest file" Style="{StaticResource LabelTextStyle}" />
                                    <TextBox x:Name="OutputManifestBox" />
                                </StackPanel>
                                <Button Grid.Row="2" Grid.Column="1" Content="Save as" Width="96" VerticalAlignment="Bottom" Margin="0,0,0,12" Click="BrowseOutputButton_Click" />

                                <Grid Grid.Row="3" Grid.ColumnSpan="2" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Version" Style="{StaticResource LabelTextStyle}" />
                                        <TextBox x:Name="VersionBox" />
                                    </StackPanel>
                                    <CheckBox x:Name="ReportExtraFilesBox" Grid.Column="1" Content="Report extra files" Margin="0,25,12,0" />
                                    <CheckBox x:Name="CompressFilesBox" Grid.Column="2" Content="Compress as .gz" Margin="0,25,0,0" />
                                </Grid>

                                <StackPanel Grid.Row="4" Margin="0,0,10,12">
                                    <TextBlock Text="Compressed out" Style="{StaticResource LabelTextStyle}" />
                                    <TextBox x:Name="CompressedOutputBox" />
                                </StackPanel>
                                <Button Grid.Row="4" Grid.Column="1" Content="Browse" Width="96" VerticalAlignment="Bottom" Margin="0,0,0,12" Click="BrowseCompressedOutputButton_Click" />

                                <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Margin="0,0,0,18">
                                    <TextBlock Text="Ignore rules" Style="{StaticResource LabelTextStyle}" />
                                    <TextBox x:Name="IgnoreRulesBox" Height="86"
                                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                                             FontFamily="Consolas" FontSize="12" />
                                </StackPanel>

                                <TextBlock Grid.Row="6" Grid.ColumnSpan="2" Text="Launcher self-update" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,14" />

                                <StackPanel Grid.Row="7" Margin="0,0,10,12">
                                    <TextBlock Text="Launcher exe" Style="{StaticResource LabelTextStyle}" />
                                    <TextBox x:Name="LauncherFileBox" />
                                </StackPanel>
                                <Button Grid.Row="7" Grid.Column="1" Content="Browse" Width="96" VerticalAlignment="Bottom" Margin="0,0,0,12" Click="BrowseLauncherButton_Click" />

                                <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Margin="0,0,0,18">
                                    <TextBlock Text="Launcher URL" Style="{StaticResource LabelTextStyle}" />
                                    <TextBox x:Name="LauncherUrlBox" />
                                </StackPanel>

                                <TextBlock Grid.Row="9" Grid.ColumnSpan="2" Text="News" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,14" />

                                <StackPanel Grid.Row="10" Grid.ColumnSpan="2" Margin="0,0,0,12">
                                    <TextBlock Text="News title" Style="{StaticResource LabelTextStyle}" />
                                    <TextBox x:Name="NewsTitleBox" />
                                </StackPanel>

                                <StackPanel Grid.Row="11" Grid.ColumnSpan="2">
                                    <TextBlock Text="News body" Style="{StaticResource LabelTextStyle}" />
                                    <TextBox x:Name="NewsBodyBox" Height="82"
                                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource HeroBrush}" BorderBrush="#3B3441" BorderThickness="1" CornerRadius="8" Padding="22" Margin="0,0,0,18">
                        <StackPanel>
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="StatusText" Text="Idle" FontSize="27" FontWeight="Bold" />
                                    <TextBlock x:Name="CurrentFileText" Text="Waiting" Foreground="{StaticResource TextSoftBrush}" FontSize="13" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="#241D17" BorderBrush="#5F4B25" BorderThickness="1" CornerRadius="6" Padding="14,9" VerticalAlignment="Top">
                                    <TextBlock x:Name="FileCountText" Text="0 files" Foreground="#F6F1E8" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                            <ProgressBar x:Name="MainProgressBar" Minimum="0" Maximum="100" Value="0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Activity log" Style="{StaticResource SectionTitleStyle}" Margin="18,16,18,12" />
                            <TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                                     Background="#10131A" BorderThickness="0" Padding="14" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <TextBlock Grid.Row="2" Text="Ready" Foreground="{StaticResource TextMutedBrush}" Margin="0,16,0,0" />
        </Grid>
    </Grid>
</Window>

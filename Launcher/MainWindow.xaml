<Window x:Class="Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="L2 Modern Updater" Height="720" Width="1120" MinHeight="640" MinWidth="980"
        Background="#0F1117" Foreground="#F6F1E8" FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#191B24" />
        <SolidColorBrush x:Key="SurfaceAltBrush" Color="#20232D" />
        <SolidColorBrush x:Key="SurfaceDeepBrush" Color="#11141C" />
        <SolidColorBrush x:Key="StrokeBrush" Color="#343847" />
        <SolidColorBrush x:Key="StrokeSoftBrush" Color="#292D39" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#B5AD9F" />
        <SolidColorBrush x:Key="TextSoftBrush" Color="#D8D0C3" />
        <SolidColorBrush x:Key="AccentBrush" Color="#C89B3C" />
        <SolidColorBrush x:Key="AccentHotBrush" Color="#E0B655" />
        <SolidColorBrush x:Key="DangerBrush" Color="#B84E55" />
        <SolidColorBrush x:Key="BlueBrush" Color="#4477C8" />

        <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#141722" Offset="0" />
            <GradientStop Color="#181820" Offset="0.46" />
            <GradientStop Color="#10131A" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2A2430" Offset="0" />
            <GradientStop Color="#1A1D27" Offset="0.54" />
            <GradientStop Color="#232018" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PlayBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F1CA67" Offset="0" />
            <GradientStop Color="#C79232" Offset="1" />
        </LinearGradientBrush>

        <SolidColorBrush x:Key="PlayDisabledBrush" Color="#2A2E3A" />
        <SolidColorBrush x:Key="PlayDisabledBorderBrush" Color="#3B4050" />

        <Style x:Key="PanelBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeSoftBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#F6F1E8" />
        </Style>

        <Style x:Key="LabelTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Foreground" Value="#F6F1E8" />
            <Setter Property="Background" Value="#2A2E3A" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="58" />
            <Setter Property="Padding" Value="32,12" />
            <Setter Property="Background" Value="{StaticResource PlayBrush}" />
            <Setter Property="BorderBrush" Value="#F3D489" />
            <Setter Property="Foreground" Value="#17120A" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="Bold" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{StaticResource PlayDisabledBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource PlayDisabledBorderBrush}" />
                    <Setter Property="Foreground" Value="#8D95A3" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="42" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="18" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Foreground" Value="#F6F1E8" />
            <Setter Property="Background" Value="{StaticResource SurfaceDeepBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
            <Setter Property="CaretBrush" Value="#F6F1E8" />
            <Setter Property="SelectionBrush" Value="#735C2B" />
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource AccentHotBrush}" />
            <Setter Property="Background" Value="#0F1219" />
            <Setter Property="BorderBrush" Value="#2D303B" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid Margin="26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="L2 Modern Updater" FontSize="30" FontWeight="Bold" />
                    <TextBlock x:Name="ClientDirectoryText" Text="Not selected" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ConfigSourceText" Text="auto" Visibility="Collapsed" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="AutoLoginButton" Content="AutoLogin" Width="112" Margin="0,0,12,0" Visibility="Collapsed" Click="AutoLoginButton_Click" />
                    <Button x:Name="SettingsButton" Content="Settings" Width="104" Margin="0,0,12,0" ToolTip="Settings" Click="SettingsButton_Click" />
                    <Button x:Name="PlayButton" Content="PLAY" Width="190" Height="58"
                            Style="{StaticResource PlayButtonStyle}" Click="PlayButton_Click" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.05*" />
                    <ColumnDefinition Width="1.05*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,18,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource HeroBrush}" BorderBrush="#3B3441" BorderThickness="1" CornerRadius="8" Padding="24">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock x:Name="StatusText" Text="Idle" FontSize="32" FontWeight="Bold" />
                                <TextBlock x:Name="CurrentFileText" Text="Waiting for manifest" Foreground="{StaticResource TextSoftBrush}" FontSize="14" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <Border Grid.Column="1" Background="#241D17" BorderBrush="#5F4B25" BorderThickness="1" CornerRadius="6" Padding="16,10" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="FILES" Foreground="{StaticResource TextMutedBrush}" FontSize="11" HorizontalAlignment="Right" />
                                    <TextBlock x:Name="TransferText" Text="0 / 0" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Border>

                            <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,26,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="CurrentFileProgressText" Grid.Column="1" Text="0%" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                                <ProgressBar x:Name="CurrentFileProgressBar" Grid.ColumnSpan="2" Minimum="0" Maximum="100" Value="0" Margin="0,16,0,12" />

                                <TextBlock x:Name="OverallProgressText" Grid.Row="1" Grid.Column="1" Text="0%" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                                <ProgressBar x:Name="MainProgressBar" Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="100" Value="0" Margin="0,16,0,0" />
                            </Grid>

                            <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,22,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Maintenance" Style="{StaticResource SectionTitleStyle}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="CheckButton" Content="CHECK" Width="104" Margin="0,0,10,0" Click="CheckButton_Click" />
                                    <Button x:Name="RepairButton" Content="REPAIR" Width="104" Margin="0,0,10,0" Background="{StaticResource DangerBrush}" BorderBrush="#D06A70" Click="RepairButton_Click" />
                                    <Button x:Name="UpdateButton" Content="UPDATE" Width="104" Background="{StaticResource BlueBrush}" BorderBrush="#6790D6" Click="UpdateButton_Click" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}" Padding="0" Margin="0,18,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Log" Style="{StaticResource SectionTitleStyle}" Margin="18,16,18,12" />
                            <TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                                     Background="#10131A" BorderThickness="0" Padding="14" />
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" Padding="18" CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="News" Style="{StaticResource SectionTitleStyle}" />
                        </StackPanel>

                        <ListBox x:Name="NewsList" Grid.Row="1" Background="#141821" BorderBrush="#303440" Foreground="#F6F1E8" Padding="4">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#2C303B" BorderThickness="0,0,0,1" Padding="8,10" Margin="0,0,0,2">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding PublishedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,3,0,7" />
                                            <TextBlock Text="{Binding Body}" Foreground="{StaticResource TextSoftBrush}" TextWrapping="Wrap" LineHeight="18" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <TextBlock Grid.Row="2" Text="" Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,0" />
        </Grid>
    </Grid>
</Window>

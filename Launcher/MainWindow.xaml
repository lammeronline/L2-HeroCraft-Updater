<Window x:Class="Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="L2 Modern Updater" Height="720" Width="1120" MinHeight="640" MinWidth="980"
        WindowStyle="None" ResizeMode="CanResize"
        Background="#0F1117" Foreground="#F6F1E8" FontFamily="Segoe UI">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#191B24" />
        <SolidColorBrush x:Key="SurfaceAltBrush" Color="#20232D" />
        <SolidColorBrush x:Key="SurfaceDeepBrush" Color="#11141C" />
        <SolidColorBrush x:Key="StrokeBrush" Color="#343847" />
        <SolidColorBrush x:Key="StrokeSoftBrush" Color="#292D39" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#B5AD9F" />
        <SolidColorBrush x:Key="TextSoftBrush" Color="#D8D0C3" />
        <SolidColorBrush x:Key="AccentBrush" Color="#C89B3C" />
        <SolidColorBrush x:Key="AccentHotBrush" Color="#E0B655" />
        <SolidColorBrush x:Key="DangerBrush" Color="#B84E55" />
        <SolidColorBrush x:Key="BlueBrush" Color="#4477C8" />

        <ImageBrush x:Key="WindowBackgroundBrush"
                    ImageSource="pack://application:,,,/Image/background.png"
                    Stretch="UniformToFill"
                    AlignmentX="Center"
                    AlignmentY="Center" />

        <LinearGradientBrush x:Key="BackgroundOverlayBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#D90F1117" Offset="0" />
            <GradientStop Color="#AA11141C" Offset="0.48" />
            <GradientStop Color="#E610131A" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2A2430" Offset="0" />
            <GradientStop Color="#1A1D27" Offset="0.54" />
            <GradientStop Color="#232018" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PlayBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F1CA67" Offset="0" />
            <GradientStop Color="#C79232" Offset="1" />
        </LinearGradientBrush>

        <SolidColorBrush x:Key="PlayDisabledBrush" Color="#2A2E3A" />
        <SolidColorBrush x:Key="PlayDisabledBorderBrush" Color="#3B4050" />

        <Style x:Key="PanelBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeSoftBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#F6F1E8" />
        </Style>

        <Style x:Key="LabelTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Foreground" Value="#F6F1E8" />
            <Setter Property="Background" Value="#2A2E3A" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="58" />
            <Setter Property="Padding" Value="32,12" />
            <Setter Property="Background" Value="{StaticResource PlayBrush}" />
            <Setter Property="BorderBrush" Value="#F3D489" />
            <Setter Property="Foreground" Value="#17120A" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="Bold" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{StaticResource PlayDisabledBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource PlayDisabledBorderBrush}" />
                    <Setter Property="Foreground" Value="#8D95A3" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CompactCommandButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="108" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="42" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="18" />
        </Style>

        <Style x:Key="WindowCommandButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextSoftBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#2A2E3A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.82" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseWindowCommandButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowCommandButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Foreground" Value="#F6F1E8" />
            <Setter Property="Background" Value="{StaticResource SurfaceDeepBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
            <Setter Property="CaretBrush" Value="#F6F1E8" />
            <Setter Property="SelectionBrush" Value="#735C2B" />
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource AccentHotBrush}" />
            <Setter Property="Background" Value="#0F1219" />
            <Setter Property="BorderBrush" Value="#2D303B" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="2" Background="{StaticResource BackgroundOverlayBrush}" />

        <Grid Grid.Row="0" Background="#01000000">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource WindowCommandButtonStyle}"
                        ToolTip="Minimize"
                        Click="MinimizeWindowButton_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Data="M 2,8 L 12,8"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.6"
                          StrokeStartLineCap="Square"
                          StrokeEndLineCap="Square" />
                </Button>
                <Button x:Name="MaximizeWindowButton"
                        Style="{StaticResource WindowCommandButtonStyle}"
                        ToolTip="Maximize"
                        Click="MaximizeWindowButton_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Rectangle Width="10" Height="10"
                               Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                               StrokeThickness="1.4" />
                </Button>
                <Button Style="{StaticResource CloseWindowCommandButtonStyle}"
                        ToolTip="Close"
                        Click="CloseWindowButton_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Data="M 3,3 L 11,11 M 11,3 L 3,11"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.7"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="26,8,26,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="L2 Modern Updater" FontSize="30" FontWeight="Bold" />
                    <TextBlock x:Name="ClientDirectoryText" Text="Not selected" Visibility="Collapsed" />
                    <TextBlock x:Name="ConfigSourceText" Text="auto" Visibility="Collapsed" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="AutoLoginButton" Content="AutoLogin" Width="112" Margin="0,0,12,0" Visibility="Collapsed" Click="AutoLoginButton_Click" />
                    <Button x:Name="SettingsButton" Content="Settings" Width="104" ToolTip="Settings" Click="SettingsButton_Click" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="TopContentRow" Height="*" />
                    <RowDefinition x:Name="BottomControlsRow" Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="MainContentColumn" Width="2.05*" />
                        <ColumnDefinition x:Name="NewsColumn" Width="1.05*" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="LogPanel" Grid.Column="0" Style="{StaticResource PanelBorderStyle}" Padding="0" Margin="0,0,18,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Log" Style="{StaticResource SectionTitleStyle}" Margin="18,16,18,12" />
                            <TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                                     Background="#10131A" BorderThickness="0" Padding="14" />
                        </Grid>
                    </Border>

                    <Border x:Name="NewsPanel" Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" Padding="18" CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="News" Style="{StaticResource SectionTitleStyle}" />
                            </StackPanel>

                            <Border Grid.Row="1" Background="#141821" BorderBrush="#303440" BorderThickness="1">
                                <WebBrowser x:Name="NewsBrowser" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <Border x:Name="BottomControlsPanel" Grid.Row="1" Background="{StaticResource HeroBrush}" BorderBrush="#3B3441" BorderThickness="1" CornerRadius="8" Padding="20,16" Margin="0,28,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock x:Name="StatusText" Text="Loading config" FontSize="29" FontWeight="Bold" />
                                <TextBlock x:Name="CurrentFileText" Text="Preparing launcher" Foreground="{StaticResource TextSoftBrush}" FontSize="13" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <Border Grid.Column="1" Background="#241D17" BorderBrush="#5F4B25" BorderThickness="1" CornerRadius="6" Padding="14,8" VerticalAlignment="Bottom">
                                <StackPanel>
                                    <TextBlock Text="FILES" Foreground="{StaticResource TextMutedBrush}" FontSize="10" HorizontalAlignment="Right" />
                                    <TextBlock x:Name="TransferText" Text="0 / 0" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Border>

                            <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,18,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="CurrentFileProgressText" Grid.Column="1" Text="0%" Width="54"
                                           TextAlignment="Right" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                                <ProgressBar x:Name="CurrentFileProgressBar" Grid.ColumnSpan="2" Minimum="0" Maximum="100" Value="0" Margin="0,14,0,9" />

                                <TextBlock x:Name="OverallProgressText" Grid.Row="1" Grid.Column="1" Text="0%" Width="54"
                                           TextAlignment="Right" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                                <ProgressBar x:Name="MainProgressBar" Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="100" Value="0" Margin="0,14,0,0" />
                            </Grid>
                        </Grid>

                        <Grid Grid.Column="1" Height="116" Margin="22,0,0,0" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <Button x:Name="CheckButton" Content="CHECK" Style="{StaticResource CompactCommandButtonStyle}" Margin="0,0,0,7" Click="CheckButton_Click" />
                                <Button x:Name="RepairButton" Content="REPAIR" Style="{StaticResource CompactCommandButtonStyle}" Margin="0,0,0,7" Background="{StaticResource DangerBrush}" BorderBrush="#D06A70" Click="RepairButton_Click" />
                                <Button x:Name="UpdateButton" Content="UPDATE" Style="{StaticResource CompactCommandButtonStyle}" Background="{StaticResource BlueBrush}" BorderBrush="#6790D6" Click="UpdateButton_Click" />
                            </StackPanel>

                            <Button x:Name="PlayButton" Grid.Column="1"
                                    Content="PLAY" Width="118" Height="116" Margin="12,0,0,0"
                                    Style="{StaticResource PlayButtonStyle}" Click="PlayButton_Click" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>

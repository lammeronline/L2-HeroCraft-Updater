<Window x:Class="Launcher.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Launcher Settings" Height="620" MinHeight="560" Width="660" MinWidth="620" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        Background="#0F1117" Foreground="#F6F1E8" FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#191B24" />
        <SolidColorBrush x:Key="SurfaceDeepBrush" Color="#11141C" />
        <SolidColorBrush x:Key="StrokeBrush" Color="#343847" />
        <SolidColorBrush x:Key="StrokeSoftBrush" Color="#292D39" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#B5AD9F" />
        <SolidColorBrush x:Key="TextSoftBrush" Color="#D8D0C3" />
        <SolidColorBrush x:Key="AccentBrush" Color="#C89B3C" />

        <Style x:Key="PanelBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeSoftBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#F6F1E8" />
        </Style>

        <Style x:Key="LabelTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Foreground" Value="#F6F1E8" />
            <Setter Property="Background" Value="#2A2E3A" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Foreground" Value="#F6F1E8" />
            <Setter Property="Background" Value="{StaticResource SurfaceDeepBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
            <Setter Property="CaretBrush" Value="#F6F1E8" />
            <Setter Property="SelectionBrush" Value="#735C2B" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="Foreground" Value="#171A22" />
            <Setter Property="Background" Value="#ECE4D4" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#171A22" />
            <Setter Property="Background" Value="#F6F1E8" />
            <Setter Property="Padding" Value="9,6" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextSoftBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="Settings" FontSize="26" FontWeight="Bold" />
            <TextBlock Text="Client location, update source and launch preferences" Foreground="{StaticResource TextMutedBrush}" FontSize="13" Margin="0,4,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
            <Border Style="{StaticResource PanelBorderStyle}" Margin="0,0,0,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Updater" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,14" />

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,12">
                        <TextBlock Text="Client folder" Style="{StaticResource LabelTextStyle}" />
                        <TextBox x:Name="ClientDirectoryBox" />
                    </StackPanel>
                    <Button Grid.Row="1" Grid.Column="1" Content="Browse" Width="96" VerticalAlignment="Bottom" Margin="0,0,0,12" Click="BrowseClientButton_Click" />

                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Config source" Style="{StaticResource LabelTextStyle}" />
                        <TextBox x:Name="ConfigSourceBox" />
                        <TextBlock Text="Leave empty to use local config.json first, then remote config." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,5,0,0" />
                    </StackPanel>
                    <Button Grid.Row="2" Grid.Column="1" Content="Browse" Width="96" VerticalAlignment="Bottom" Click="BrowseConfigButton_Click" />
                </Grid>
            </Border>

            <Border x:Name="ClientSettingsPanel" Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="Client" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,14" />

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Display mode" Style="{StaticResource LabelTextStyle}" />
                        <ComboBox x:Name="DisplayModeBox">
                            <ComboBoxItem Content="Windowed" />
                            <ComboBoxItem Content="Borderless" />
                            <ComboBoxItem Content="Fullscreen" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,18,0">
                        <TextBlock Text="Resolution" Style="{StaticResource LabelTextStyle}" />
                        <ComboBox x:Name="ResolutionBox" />
                    </StackPanel>

                    <CheckBox x:Name="AudioMuteBox" Grid.Row="1" Grid.Column="2" Content="Mute audio" Margin="0,25,0,0" />
                </Grid>
            </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Width="96" Margin="0,0,10,0" Click="CancelButton_Click" />
            <Button Content="Save" Width="96" Margin="0,0,10,0" BorderBrush="{StaticResource AccentBrush}" Click="SaveButton_Click" />
            <Button x:Name="ApplyButton" Content="Apply" Width="96" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" Foreground="#17120A" Click="ApplyButton_Click" />
        </StackPanel>
    </Grid>
</Window>

<Window x:Class="Launcher.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Launcher Settings" Height="620" MinHeight="560" Width="660" MinWidth="620" ResizeMode="CanResizeWithGrip"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        Background="#0F1117" Foreground="#F6F1E8" FontFamily="Segoe UI">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#191B24" />
        <SolidColorBrush x:Key="SurfaceDeepBrush" Color="#11141C" />
        <SolidColorBrush x:Key="StrokeBrush" Color="#343847" />
        <SolidColorBrush x:Key="StrokeSoftBrush" Color="#292D39" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#B5AD9F" />
        <SolidColorBrush x:Key="TextSoftBrush" Color="#D8D0C3" />
        <SolidColorBrush x:Key="AccentBrush" Color="#C89B3C" />
        <SolidColorBrush x:Key="DangerBrush" Color="#B84E55" />

        <Style x:Key="PanelBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeSoftBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#F6F1E8" />
        </Style>

        <Style x:Key="LabelTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Foreground" Value="#F6F1E8" />
            <Setter Property="Background" Value="#2A2E3A" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Foreground" Value="#F6F1E8" />
            <Setter Property="Background" Value="{StaticResource SurfaceDeepBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
            <Setter Property="CaretBrush" Value="#F6F1E8" />
            <Setter Property="SelectionBrush" Value="#735C2B" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="Foreground" Value="#171A22" />
            <Setter Property="Background" Value="#ECE4D4" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#171A22" />
            <Setter Property="Background" Value="#F6F1E8" />
            <Setter Property="Padding" Value="9,6" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextSoftBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="WindowCommandButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextSoftBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#2A2E3A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.82" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseWindowCommandButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowCommandButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#01000000">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource WindowCommandButtonStyle}" ToolTip="Minimize" Click="MinimizeWindowButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Data="M 2,8 L 12,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" />
                </Button>
                <Button x:Name="MaximizeWindowButton" Style="{StaticResource WindowCommandButtonStyle}" ToolTip="Maximize" Click="MaximizeWindowButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Rectangle Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" />
                </Button>
                <Button Style="{StaticResource CloseWindowCommandButtonStyle}" ToolTip="Close" Click="CloseWindowButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Data="M 3,3 L 11,11 M 11,3 L 3,11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="24,10,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="Settings" FontSize="26" FontWeight="Bold" />
            <TextBlock Text="Client location, update source and launch preferences" Foreground="{StaticResource TextMutedBrush}" FontSize="13" Margin="0,4,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
            <Border Style="{StaticResource PanelBorderStyle}" Margin="0,0,0,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Updater" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,14" />

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,12">
                        <TextBlock Text="Client folder" Style="{StaticResource LabelTextStyle}" />
                        <TextBox x:Name="ClientDirectoryBox" />
                    </StackPanel>
                    <Button Grid.Row="1" Grid.Column="1" Content="Browse" Width="96" VerticalAlignment="Bottom" Margin="0,0,0,12" Click="BrowseClientButton_Click" />

                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,12">
                        <TextBlock Text="Config URL / file" Style="{StaticResource LabelTextStyle}" />
                        <TextBox x:Name="ConfigSourceBox" />
                        <TextBlock Text="Use https://.../config.json for remote settings. Empty uses the built-in URL; local config.json is only fallback." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Row="2" Grid.Column="1" Content="Browse" Width="96" VerticalAlignment="Bottom" Margin="0,0,0,12" Click="BrowseConfigButton_Click" />

                    <CheckBox x:Name="ShowLogBox" Grid.Row="3" Grid.ColumnSpan="2" Content="Show activity log" />
                </Grid>
            </Border>

            <Border x:Name="ClientSettingsPanel" Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="Client" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,14" />

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Display mode" Style="{StaticResource LabelTextStyle}" />
                        <ComboBox x:Name="DisplayModeBox">
                            <ComboBoxItem Content="Windowed" />
                            <ComboBoxItem Content="Borderless" />
                            <ComboBoxItem Content="Fullscreen" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,18,0">
                        <TextBlock Text="Resolution" Style="{StaticResource LabelTextStyle}" />
                        <ComboBox x:Name="ResolutionBox" />
                    </StackPanel>

                    <CheckBox x:Name="AudioMuteBox" Grid.Row="1" Grid.Column="2" Content="Mute audio" Margin="0,25,0,0" />
                </Grid>
            </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Width="96" Margin="0,0,10,0" Click="CancelButton_Click" />
            <Button Content="Save" Width="96" Margin="0,0,10,0" BorderBrush="{StaticResource AccentBrush}" Click="SaveButton_Click" />
            <Button x:Name="ApplyButton" Content="Apply" Width="96" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" Foreground="#17120A" Click="ApplyButton_Click" />
        </StackPanel>
        </Grid>
    </Grid>
</Window>
